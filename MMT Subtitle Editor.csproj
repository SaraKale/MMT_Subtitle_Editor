<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MMT Subtitle Editor</AssemblyName>
    <Title>MMT Subtitle Editor</Title>
    <Authors>SaraKale</Authors>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2</AssemblyVersion>
    <FileVersion>1.0.2</FileVersion>
    <ApplicationIcon>Assets\MMTicon.ico</ApplicationIcon>
    <StartupObject>MMTGui.Avalonia.Program</StartupObject>
  </PropertyGroup>

  <!--
    单文件发布（PublishSingleFile）时的原生库处理。

    背景：单文件 exe 默认会把原生 DLL 一并塞进 bundle，启动时再解压到
    %TEMP%\.net\... 才能加载。若该目录被拒（杀软拦截、ACL 损坏、权限不足），
    apphost 会在进入 Main 之前就失败，表现为「双击没反应、无窗口、无报错」：

        Failed to create default extraction directory [%TEMP%\.net]. error code: 5
        Failure processing application bundle.

    这里把原生库排除在 bundle 之外（IncludeNativeLibrariesForSelfExtract=false），
    让 libSkiaSharp / libHarfBuzzSharp / av_libglesv2 / libonigwrap 等
    与 exe 并列放置，从而**完全不再触发解压**。

    代价：发布产物中除主 exe 外会多出几个原生 dll，需与 exe 放在同一目录。
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

<ItemGroup>
  <None Update="example\**\*">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
  <None Update="HelpDOC\image\**\*">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
  <None Update="HelpDOC\*.html">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
</ItemGroup>


  <ItemGroup>
    <AvaloniaXaml Remove="HelpDOC\**" />
    <AvaloniaXaml Remove="备份\**" />
    <Compile Remove="HelpDOC\**" />
    <Compile Remove="备份\**" />
    <EmbeddedResource Remove="HelpDOC\**" />
    <EmbeddedResource Remove="备份\**" />
    <EmbeddedResource Remove="Resources\_test.resx" />
    <None Remove="HelpDOC\**" />
    <None Remove="备份\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="澶氬钩鍙版鏋剁紪璇?bat" />
    <None Remove="README.md" />
    <None Remove="README_JP.md" />
    <None Remove="README_SC.md" />
    <None Remove="README_TC.md" />
    <None Remove="多平台框架编译.bat" />
    <None Remove="批量压缩跨平台文件夹.bat" />
    <None Remove="鎵归噺鍘嬬缉璺ㄥ钩鍙版枃浠跺す.bat" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\MMTicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.4" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.4">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SukiUI" Version="6.0.3" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\OpenLRCFile.axaml.cs">
      <DependentUpon>OpenLRCFile.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
