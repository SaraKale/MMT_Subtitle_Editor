// 指定字体
:font Noto Sans CJK TC Medium
// 字体大小
:size 12
// 字体颜色
:fontcolor 255,255,255
// 水平居中
:align_center 
// 底部对齐
:valign_bottom
// 屏幕尺寸
:screen 1920,1080
// 字幕位置
:pos 0,-90
// 不透明度
:alpha 1
// 指定描边粗细
:edge 8
// 描边颜色
:edgecolor 181,51,43
// 将描边边角设为圆形
:edge_round
// 淡入淡出
:fade 0

@30.44,3.62
text lyrics
歌词文本
歌詞文本
歌詞テキスト

:end
